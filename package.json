{
  "name": "inazuma-tailwind",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run css:build && npm run img:variants && vite build",
    "css:build": "tailwindcss -i ./src/css/tailwind.css -o ./assets/css/main.min.css --minify",
    "img:variants": "node scripts/generate-image-variants.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "tw-install": "npm install -D tailwindcss",
    "tw-init": "npx tailwindcss init",
    "tw-build": "npx tailwindcss -i ./src/css/tailwind.css -o ./assets/css/main.css --watch",
    "tw-minify": "npx tailwindcss -o ./assets/css/main.min.css --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranyeh24/inazuma-tailwind.git"
  },
  "keywords": [
    "company",
    "landing page"
  ],
  "author": "Ranyeh",
  "license": "MIT",
  "description": "Tailwind CSS Company Landing Page Template by Ranyeh.",
  "devDependencies": {
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.10",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lineicons": "^1.3.2"
  }
}
